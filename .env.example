# Gold Bot Monorepo Configuration

# ============================================================================
# Trading Engine (Go, :8880)
# ============================================================================

# Database
DSN=postgres://goldbot:password@postgres:5432/goldbot?sslmode=disable
DBPath=data/gold_bolt.sqlite

# HTTP Server
HTTP_ADDR=0.0.0.0:8880

# Authentication
ADMIN_TOKEN=your_admin_token_here

# ============================================================================
# Agents (NestJS, :3100)
# ============================================================================

# Gold-bot API
GOLDBOT_API_URL=http://localhost:8880
GOLDBOT_API_TOKEN=your-api-token-here

# Redis
REDIS_URL=redis://localhost:6379

# LLM Configuration
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-your-api-key
LLM_MODEL=gpt-4o
LLM_FALLBACK_MODEL=gpt-4o-mini
LLM_TIMEOUT=120000
LLM_MAX_RETRIES=3
LLM_ENABLE_PROMPT_CACHING=false
LLM_PROMPT_CACHE_RETENTION=in_memory

# Scheduler
SCHEDULE_CRON=*/5 * * * *

# Accounts
ACCOUNTS_CONFIG=[{"id":"acc-001","symbols":["XAUUSD","XAGUSD"]}]

# Logging
LOG_LEVEL=info

# HTTP Server
PORT=3100

# ============================================================================
# Monitoring (Prometheus + Grafana)
# ============================================================================

GRAFANA_USER=admin
GRAFANA_PASSWORD=admin_change_me
