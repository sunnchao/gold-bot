# Gold Bot Monorepo Configuration

# ============================================================================
# Trading Engine (Go, :8880)
# ============================================================================

# Database
DSN=postgres://goldbot:password@postgres:5432/goldbot?sslmode=disable
DBPath=data/gold_bolt.sqlite

# HTTP Server
HTTP_ADDR=0.0.0.0:8880

# Authentication
ADMIN_TOKEN=your_admin_token_here

# ============================================================================
# Agents (NestJS, :3100)
# ============================================================================

# Gold-bot API
GOLDBOT_API_URL=http://127.0.0.1:3000
GOLDBOT_API_TOKEN=your-api-token-here

# Redis
REDIS_URL=redis://localhost:6379

# LLM Configuration
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-your-api-key
LLM_MODEL=gpt-4o
LLM_FALLBACK_MODEL=gpt-4o-mini
LLM_TIMEOUT=120000
LLM_MAX_RETRIES=3
LLM_ENABLE_PROMPT_CACHING=false

# Scheduler
SCHEDULE_CRON=*/5 * * * *

# Accounts
ACCOUNTS_CONFIG=[{"id":"acc-001","symbols":["XAUUSD","XAGUSD"]}]

# Logging
LOG_LEVEL=info

# HTTP Server
PORT=3100

# ============================================================================
# Monitoring (Prometheus + Grafana)
# ============================================================================

GRAFANA_USER=admin
GRAFANA_PASSWORD=admin_change_me

# ============================================================================
# Node Monorepo Runtime (app-server, :3000)
# ============================================================================

GB_APP_ENV=development
GB_APP_SERVER_HOST=127.0.0.1
GB_APP_SERVER_PORT=3000
GB_NODE_SHADOW_MODE=true

# Persistence (leave both empty to use in-memory store)
GB_EA_STORE_SQLITE_PATH=data/gold_bolt_node.sqlite
GB_EA_STORE_POSTGRES_DSN=

# Authentication (falls back to ADMIN_TOKEN above if unset)
GB_ADMIN_TOKEN=
GB_LEGACY_TOKENS_PATH=

# Redis (optional, for future scaling)
GB_REDIS_URL=

# Notifications
GB_DISCORD_WEBHOOK_URL=
GB_FEISHU_WEBHOOK_URL=
GB_FEISHU_SECRET=
