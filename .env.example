# Gold-bot Go engine API
GOLDBOT_API_URL=http://localhost:8880
GOLDBOT_API_TOKEN=your-api-token-here

# Redis (for BullMQ scheduler)
REDIS_URL=redis://localhost:6379

# LLM Configuration
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-your-api-key
LLM_MODEL=gpt-4o
LLM_FALLBACK_MODEL=gpt-4o-mini
LLM_TIMEOUT=120000
LLM_MAX_RETRIES=3
LLM_ENABLE_PROMPT_CACHING=false
LLM_PROMPT_CACHE_RETENTION=in_memory

# Scheduler
SCHEDULE_CRON=*/5 * * * *

# Accounts (JSON array)
ACCOUNTS_CONFIG=[{"id":"acc-001","symbols":["XAUUSD","XAGUSD"]}]

# Logging
LOG_LEVEL=info

# HTTP Server
PORT=3100
