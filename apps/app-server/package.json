{
  "name": "app-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "pnpm run typecheck"
  },
  "dependencies": {
    "@gold-bot/config": "workspace:*",
    "@gold-bot/notifications": "workspace:*",
    "@gold-bot/observability": "workspace:*",
    "@gold-bot/persistence": "workspace:*",
    "@gold-bot/shared-contracts": "workspace:*",
    "@gold-bot/trading-core": "workspace:*"
  }
}
