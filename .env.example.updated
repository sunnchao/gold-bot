# ==========================================
# LLM Configuration (Prompt Caching Optimized)
# ==========================================

# ===== DeepSeek Configuration (Recommended for China) =====
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-xxx
LLM_MODEL=deepseek-chat
LLM_FALLBACK_MODEL=deepseek-chat

# 🔥 Prompt Caching: DeepSeek does not support native prompt caching
# Set to false (default) to use standard API calls
LLM_ENABLE_PROMPT_CACHING=false

# ===== Anthropic Claude (Best Caching - 75-80% cost reduction) =====
# Only enable if you're using official Anthropic API
# LLM_PROVIDER=anthropic
# LLM_BASE_URL=https://api.anthropic.com/v1
# LLM_API_KEY=sk-ant-api03-xxx
# LLM_MODEL=claude-sonnet-4-6
# LLM_FALLBACK_MODEL=claude-haiku-4-5-20251001
# LLM_ENABLE_PROMPT_CACHING=true

# ===== OpenAI (Good Caching - 40-50% cost reduction) =====
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-proj-xxx
# LLM_MODEL=gpt-4o
# LLM_FALLBACK_MODEL=gpt-4o-mini
# LLM_ENABLE_PROMPT_CACHING=false  # OpenAI uses automatic prefix caching

# ===== 智谱 GLM (No Native Caching) =====
# LLM_PROVIDER=zhipu
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LLM_API_KEY=xxx.xxx
# LLM_MODEL=glm-4-plus
# LLM_FALLBACK_MODEL=glm-4-flash
# LLM_ENABLE_PROMPT_CACHING=false

# LLM Timeouts and Retries
LLM_TIMEOUT=240000
LLM_MAX_RETRIES=3

# ==========================================
# Prompt Caching Notes
# ==========================================
#
# LLM_ENABLE_PROMPT_CACHING controls whether to use explicit cache control.
#
# When to enable (set to true):
#   - Using Anthropic Claude API (api.anthropic.com)
#   - You want to reduce costs by 75-80% on repeated analysis
#   - Willing to accept slight API format differences
#
# When to disable (set to false):
#   - Using DeepSeek, GLM, or other providers without native caching
#   - Using OpenAI (automatic caching works better)
#   - Using API proxies/gateways that don't support cache_control
#   - Testing or debugging without caching overhead
#
# The code will automatically use the correct API format based on this flag.
# No hard-coded provider detection - fully config-driven.
#

# ==========================================
# Other Configuration
# ==========================================

# Goldbot API
GOLDBOT_API_URL=http://localhost:8880
GOLDBOT_API_TOKEN=your-goldbot-token

# Redis
REDIS_URL=redis://localhost:6379

# Schedule
SCHEDULE_CRON=*/5 * * * *

# Accounts Configuration
ACCOUNTS_CONFIG='[{"id":"account1","symbols":["XAUUSD"]}]'

# Logging
LOG_LEVEL=info

# Server
PORT=3100
TZ=Asia/Shanghai
